{
  "$schema": "https://raw.githubusercontent.com/woocommerce/qit-cli/trunk/src/src/PreCommand/Schemas/qit-schema.json",
  "sut": {
    "type": "plugin",
    "slug": "agumail",
    "source": {
      "type": "local",
      "path": "./agumail-for-woocommerce"
    }
  },
  "environments": {
    "stable": {
      "php": "8.3",
      "wp": "stable",
      "woo": "stable",
      "plugins": ["woocommerce"],
      "themes": ["storefront"]
    },
    "php74": {
      "php": "7.4",
      "wp": "stable",
      "woo": "stable",
      "plugins": ["woocommerce"],
      "themes": ["storefront"]
    },
    "php83": {
      "php": "8.3",
      "wp": "stable",
      "woo": "stable",
      "plugins": ["woocommerce"],
      "themes": ["storefront"]
    },
    "woo_min": {
      "php": "7.4",
      "wp": "6.4",
      "woo": "8.0",
      "plugins": ["woocommerce"],
      "themes": ["storefront"]
    }
  },
  "test_types": {
    "activation": {
      "default": { "environment": "stable" },
      "php74": { "environment": "php74" },
      "php83": { "environment": "php83" },
      "woo_min": { "environment": "woo_min" }
    },
    "security": {
      "default": {}
    },
    "phpcompatibility": {
      "default": {}
    },
    "woo-e2e": {
      "default": { "environment": "stable" },
      "php74": { "environment": "php74" },
      "php83": { "environment": "php83" },
      "woo_min": { "environment": "woo_min" }
    }
  },
  "groups": {
    "release": {
      "activation": ["php74", "php83", "woo_min", "default"],
      "security": ["default"],
      "phpcompatibility": ["default"],
      "woo-e2e": ["php74", "php83", "woo_min", "default"]
    }
  }
}
